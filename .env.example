# Development-only values. Never commit backend/.env or production credentials.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/jingwei_toolbox?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=jingwei
DB_PASSWORD=change-me-local-only
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
MYSQL_DATABASE=jingwei_toolbox
MYSQL_USER=jingwei
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
FLYWAY_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_IDENTIFIER=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
